@model ECommercePlus.Services.Cart.CartView
@{
    ViewData["Title"] = "Cart";
}
<h1 class="h3 mb-3">Your cart</h1>
@if (Model.IsEmpty)
{
    <div class="alert alert-info">Your cart is empty. <a asp-controller="Shop" asp-action="Index">Continue shopping</a>.</div>
}
else
{
    @if (Model.HasStockIssues)
    {
        <div class="alert alert-warning">Some items exceed the available stock. Please adjust the quantities before checking out.</div>
    }
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Price</th>
                <th class="cart-qty-col">Quantity</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr class="@(line.ExceedsStock ? "table-warning" : "")">
                    <td>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@line.Product.Id">@line.Product.Name</a>
                        <div class="small text-muted">SKU @line.Product.Sku &middot; @line.Product.Stock available</div>
                    </td>
                    <td class="text-end">@Money.Format(line.Product.Price)</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-1">
                            <input type="hidden" name="productId" value="@line.Product.Id"/>
                            <input type="number" name="quantity" value="@line.Quantity" min="0" max="@Math.Max(line.Product.Stock, 0)" class="form-control form-control-sm qty-input" aria-label="Quantity"/>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                        </form>
                    </td>
                    <td class="text-end">@Money.Format(line.LineTotal)</td>
                    <td class="text-end">
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@line.Product.Id"/>
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total (@Model.ItemCount items)</th>
                <th class="text-end fs-5">@Money.Format(Model.Total)</th>
                <th></th>
            </tr>
            </tfoot>
        </table>
    </div>
    <div class="d-flex justify-content-between">
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary">Continue shopping</a>
        @if (Model.HasStockIssues)
        {
            <button class="btn btn-success" disabled>Checkout</button>
        }
        else
        {
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Checkout</a>
        }
    </div>
}
