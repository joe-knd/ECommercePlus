@model Product
@{
    ViewData["Title"] = Model.Name;
}
<div class="page-banner page-banner-admin mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <p class="page-banner-eyebrow mb-1">Admin · Product</p>
        <h1 class="h3 mb-1">@Model.Name</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">View in shop</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-accent">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    </div>
</div>
<div class="card card-body shadow-sm">
    <dl class="row mb-0">
        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9"><code>@Model.Sku</code></dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Money.Format(Model.Price)</dd>
        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">@Model.Stock</dd>
        <dt class="col-sm-3">Weight</dt>
        <dd class="col-sm-9">@(Model.WeightKg is { } w ? $"{w:0.###} kg" : "-")</dd>
        <dt class="col-sm-3">Created (UTC)</dt>
        <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("u")</dd>
        <dt class="col-sm-3">Updated (UTC)</dt>
        <dd class="col-sm-9">@Model.UpdatedAtUtc.ToString("u")</dd>
    </dl>
</div>
<a asp-action="Index" class="btn btn-link mt-3 px-0">&larr; Back to products</a>
