@model ProductFormModel
@{
    ViewData["Title"] = "Edit product";
}
<h1 class="h3 mb-3">Edit product</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body">
    <partial name="_Form" model="Model"/>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
