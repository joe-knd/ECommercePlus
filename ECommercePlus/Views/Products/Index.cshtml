@model ProductListViewModel
@{
    ViewData["Title"] = "Manage products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage products</h1>
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-outline-primary">Import CSV</a>
        <a asp-action="Create" class="btn btn-primary">New product</a>
    </div>
</div>
<partial name="_SearchForm" model="Model"/>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th>Category</th>
            <th class="text-end">Price</th>
            <th class="text-end">Stock</th>
            <th class="text-end">Weight (kg)</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Result.Items.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No products found.</td></tr>
        }
        @foreach (var p in Model.Result.Items)
        {
            <tr>
                <td><code>@p.Sku</code></td>
                <td><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                <td>@p.Category</td>
                <td class="text-end">@Money.Format(p.Price)</td>
                <td class="text-end @(p.Stock == 0 ? "text-danger fw-semibold" : "")">@p.Stock</td>
                <td class="text-end">@(p.WeightKg?.ToString("0.###") ?? "-")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="@(new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Action, Model.Search.ToRouteValues))"/>
