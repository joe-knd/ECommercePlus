@model ProductListViewModel
@{
    ViewData["Title"] = "Manage products";
}
<div class="page-banner page-banner-admin mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <p class="page-banner-eyebrow mb-1">Admin · Catalog</p>
        <h1 class="h3 mb-1">Manage products</h1>
        <p class="mb-0 opacity-75">Create, edit, delete and bulk-import products.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Import" class="btn btn-light">⬆️ Import CSV</a>
        <a asp-action="Create" class="btn btn-accent">＋ New product</a>
    </div>
</div>
<partial name="_SearchForm" model="Model"/>

<div class="table-responsive table-card shadow-sm mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead>
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th>Category</th>
            <th class="text-end">Price</th>
            <th class="text-end">Stock</th>
            <th class="text-end">Weight (kg)</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Result.Items.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No products found.</td></tr>
        }
        @foreach (var p in Model.Result.Items)
        {
            <tr>
                <td><code>@p.Sku</code></td>
                <td><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                <td>@p.Category</td>
                <td class="text-end">@Money.Format(p.Price)</td>
                <td class="text-end @(p.Stock == 0 ? "text-danger fw-semibold" : "")">@p.Stock</td>
                <td class="text-end">@(p.WeightKg?.ToString("0.###") ?? "-")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="@(new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Action, Model.Search.ToRouteValues))"/>
