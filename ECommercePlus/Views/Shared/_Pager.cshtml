@model PagerModel
@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesFor(Model.Page - 1)">Previous</a>
            </li>
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesFor(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesFor(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
