@model ProductListViewModel
@{
    var s = Model.Search;
}
<form method="get" asp-action="@Model.Action" class="card card-body shadow-sm search-card mb-4" role="search">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-4">
            <label for="q" class="form-label small text-muted">Search</label>
            <input type="search" id="q" name="q" value="@s.Q" class="form-control" placeholder="Name, SKU, description or category" maxlength="200"/>
        </div>
        <div class="col-6 col-lg-2">
            <label for="category" class="form-label small text-muted">Category</label>
            <select id="category" name="category" class="form-select">
                <option value="">All</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(string.Equals(c, s.Category, StringComparison.Ordinal))">@c</option>
                }
            </select>
        </div>
        <div class="col-3 col-lg-1">
            <label for="minPrice" class="form-label small text-muted">Min $</label>
            <input type="number" id="minPrice" name="minPrice" value="@s.MinPrice" min="0" step="0.01" class="form-control"/>
        </div>
        <div class="col-3 col-lg-1">
            <label for="maxPrice" class="form-label small text-muted">Max $</label>
            <input type="number" id="maxPrice" name="maxPrice" value="@s.MaxPrice" min="0" step="0.01" class="form-control"/>
        </div>
        <div class="col-6 col-lg-2">
            <label for="sort" class="form-label small text-muted">Sort by</label>
            <select id="sort" name="sort" class="form-select">
                <option value="@ProductSort.Name" selected="@(s.Sort == ProductSort.Name)">Name</option>
                <option value="@ProductSort.PriceAsc" selected="@(s.Sort == ProductSort.PriceAsc)">Price: low to high</option>
                <option value="@ProductSort.PriceDesc" selected="@(s.Sort == ProductSort.PriceDesc)">Price: high to low</option>
                <option value="@ProductSort.Newest" selected="@(s.Sort == ProductSort.Newest)">Newest</option>
                <option value="@ProductSort.StockAsc" selected="@(s.Sort == ProductSort.StockAsc)">Lowest stock</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="inStock" name="inStock" value="true" checked="@s.InStock"/>
                <label class="form-check-label" for="inStock">In stock only</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Search</button>
                <a asp-action="@Model.Action" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>
<p class="text-muted small">@Model.Result.TotalCount product(s) found</p>
