@model int
@if (Model <= 0)
{
    <span class="badge rounded-pill bg-danger stock-badge">Out of stock</span>
}
else if (Model < 20)
{
    <span class="badge rounded-pill bg-warning text-dark stock-badge">🔥 Only @Model left</span>
}
else
{
    <span class="badge rounded-pill bg-success stock-badge">In stock</span>
}
