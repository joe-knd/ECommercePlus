@model Product
@{
    ViewData["Title"] = Model.Name;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Shop</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>
<div class="row g-4">
    <div class="col-lg-5">
        <div class="product-media product-media-lg @CategoryStyle.HueClass(Model.Category) shadow-sm">
            <span class="media-badges">
                <span class="badge rounded-pill category-tag">@CategoryStyle.Icon(Model.Category) @Model.Category</span>
                <partial name="_StockBadge" model="Model.Stock"/>
            </span>
            <span aria-hidden="true">@CategoryStyle.Icon(Model.Category)</span>
        </div>
    </div>
    <div class="col-lg-7">
        <h1 class="h2 fw-bold mb-1">@Model.Name</h1>
        <p class="sku mb-3">SKU @Model.Sku</p>
        <p class="display-6 price mb-3 @(Model.Price == 0 ? "price-free" : "")">@(Model.Price == 0 ? "Free" : Money.Format(Model.Price))</p>
        <p class="lead fs-6">@Model.Description</p>
        <div class="card card-body shadow-sm mb-3">
            <dl class="row small mb-0">
                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>
                <dt class="col-sm-4">Weight</dt>
                <dd class="col-sm-8">@(Model.WeightKg is { } w ? $"{w:0.###} kg" : "N/A")</dd>
                <dt class="col-sm-4">Availability</dt>
                <dd class="col-sm-8 mb-0"><partial name="_StockBadge" model="Model.Stock"/> <span class="text-muted">(@Model.Stock units)</span></dd>
            </dl>
        </div>
        <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-end">
            <input type="hidden" name="productId" value="@Model.Id"/>
            <div>
                <label for="quantity" class="form-label small text-muted mb-1">Quantity</label>
                <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Math.Max(1, Model.Stock)" class="form-control qty-input" disabled="@(!Model.InStock)"/>
            </div>
            <button type="submit" class="btn btn-accent btn-lg flex-fill" disabled="@(!Model.InStock)">
                @(Model.InStock ? "🛒 Add to cart" : "Out of stock")
            </button>
        </form>
    </div>
</div>
