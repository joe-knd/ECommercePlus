@model ProductListViewModel
@{
    ViewData["Title"] = "Shop";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var selectedCategory = Model.Search.Category;
}
<section class="hero mb-4">
    <span class="hero-emoji" aria-hidden="true">🛍️</span>
    <p class="hero-eyebrow mb-2">New season · Fresh stock</p>
    <h1 class="mb-2">Everything you need, delivered.</h1>
    <p class="mb-4 opacity-75 col-lg-7">Browse electronics, home, outdoors and more. Search by name, SKU or category, then check out in seconds.</p>
    <div class="d-flex flex-wrap gap-3">
        <div class="hero-stat">
            <div class="hero-stat-value">@Model.Result.TotalCount</div>
            <div class="hero-stat-label">@(string.IsNullOrEmpty(Model.Search.Q) && string.IsNullOrEmpty(selectedCategory) ? "products" : "matching products")</div>
        </div>
        <div class="hero-stat">
            <div class="hero-stat-value">@Model.Categories.Count</div>
            <div class="hero-stat-label">categories</div>
        </div>
        <div class="hero-stat">
            <div class="hero-stat-value">🔒</div>
            <div class="hero-stat-label">secure checkout</div>
        </div>
    </div>
</section>

<nav class="category-chips mb-4" aria-label="Categories">
    <a asp-action="Index" class="category-chip @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")">✨ All</a>
    @foreach (var c in Model.Categories)
    {
        <a asp-action="Index" asp-route-category="@c" class="category-chip @(string.Equals(c, selectedCategory, StringComparison.Ordinal) ? "active" : "")">@CategoryStyle.Icon(c) @c</a>
    }
</nav>

<partial name="_SearchForm" model="Model"/>

@if (Model.Result.Items.Count == 0)
{
    <div class="alert alert-info">No products match your search.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-4">
        @foreach (var p in Model.Result.Items)
        {
            <div class="col">
                <div class="card h-100 product-card">
                    <a asp-action="Details" asp-route-id="@p.Id" class="product-media @CategoryStyle.HueClass(p.Category) text-decoration-none" aria-label="@p.Name">
                        <span class="media-badges">
                            <span class="badge rounded-pill category-tag">@p.Category</span>
                            <partial name="_StockBadge" model="p.Stock"/>
                        </span>
                        <span aria-hidden="true">@CategoryStyle.Icon(p.Category)</span>
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 product-title mb-1 text-truncate-2">
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">@p.Name</a>
                        </h2>
                        <p class="sku mb-2">SKU @p.Sku</p>
                        <p class="card-text small text-muted flex-grow-1 text-truncate-2">@p.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fs-4 price @(p.Price == 0 ? "price-free" : "")">@(p.Price == 0 ? "Free" : Money.Format(p.Price))</span>
                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-1">
                                <input type="hidden" name="productId" value="@p.Id"/>
                                <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                <input type="number" name="quantity" value="1" min="1" max="@Math.Max(1, p.Stock)" class="form-control form-control-sm qty-input" aria-label="Quantity" disabled="@(!p.InStock)"/>
                                <button type="submit" class="btn btn-sm btn-accent" disabled="@(!p.InStock)">Add</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <partial name="_Pager" model="@(new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Action, Model.Search.ToRouteValues))"/>
}
