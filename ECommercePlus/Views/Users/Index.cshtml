@model IReadOnlyList<UserListItem>
@{
    ViewData["Title"] = "Users";
}
<div class="page-banner page-banner-admin mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <p class="page-banner-eyebrow mb-1">Admin · Security</p>
        <h1 class="h3 mb-1">Users</h1>
        <p class="mb-0 opacity-75">Create accounts, reset passwords, manage the Admin role and lock accounts.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-accent">＋ New user</a>
    </div>
</div>
<div class="table-responsive table-card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead>
        <tr><th>Email</th><th>Role</th><th>Status</th><th>Created (UTC)</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email @if (u.IsCurrentUser) { <span class="badge text-bg-light border">you</span> }</td>
                <td>@(u.IsAdmin ? Roles.Admin : "User")</td>
                <td>
                    @if (u.IsLockedOut) { <span class="badge bg-danger">Locked</span> }
                    else { <span class="badge bg-success">Active</span> }
                    @if (u.MustChangePassword) { <span class="badge bg-warning text-dark">Temporary password</span> }
                </td>
                <td>@(u.CreatedAtUtc == default ? "-" : u.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm"))</td>
                <td class="text-end">
                    @if (u.IsCurrentUser)
                    {
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-sm btn-outline-secondary">Change my password</a>
                    }
                    else
                    {
                        <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                            <form asp-action="ToggleAdmin" asp-route-id="@u.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">@(u.IsAdmin ? "Remove admin" : "Make admin")</button>
                            </form>
                            <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Reset password</button>
                            </form>
                            <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-warning">@(u.IsLockedOut ? "Unlock" : "Lock")</button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
