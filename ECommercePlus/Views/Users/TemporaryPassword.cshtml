@model TemporaryPasswordViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="h3 mb-3">@Model.Title</h1>
        <div class="card card-body">
            <p>Share these credentials with the user through a secure channel. <strong>The password will not be shown again.</strong></p>
            <dl class="row mb-0">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8"><code>@Model.Email</code></dd>
                <dt class="col-sm-4">Temporary password</dt>
                <dd class="col-sm-8"><code class="fs-5" data-testid="temporary-password">@Model.Password</code></dd>
            </dl>
            <p class="small text-muted mt-3 mb-0">The user will be required to choose a new password at first sign-in.</p>
        </div>
        <a asp-action="Index" class="btn btn-primary mt-3">Back to users</a>
    </div>
</div>
